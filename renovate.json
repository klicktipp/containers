{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices"
  ],
  "addLabels": ["{{updateType}}"],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchPackageNames": ["kubernetes/kubernetes"],
      "matchFileNames": ["images/kubectl/Dockerfile"],
      "automerge": true
    },
    {
      "matchPackageNames": ["openai/tunnel-client"],
      "matchFileNames": ["images/openai-tunnel-client/Dockerfile"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/Dockerfile/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s*depName=(?<depName>\\S+)(?:\\s*versioning=(?<versioning>\\S+))?[\\s\\S]*?_VERSION\\s*=\\s*(?<currentValue>[^\n\r]*)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
